# journal 环境变量模板 —— 复制为 .env.journal 并填入真实值
# .env.journal 权限 600，不进 git（.gitignore 已忽略）
# systemd EnvironmentFile 使用：见 deploy/systemd/journal-api.service

# MySQL（用 03_create_db_users.sh 生成的强随机口令）
JOURNAL_DB_HOST=127.0.0.1
JOURNAL_DB_PORT=3306
JOURNAL_DB_NAME=journal
JOURNAL_DB_USER=journal_app
JOURNAL_DB_PASSWORD=

# 会话 / 安全（openssl rand -hex 32 生成）
SESSION_SECRET=

# FastAPI 监听
HOST=127.0.0.1
PORT=8000